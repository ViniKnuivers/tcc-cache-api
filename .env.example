# Copie para .env:  cp .env.example .env
# Valores locais de desenvolvimento (não são segredos). Nunca commite o .env.

# Postgres (docker-compose.yml) — porta 5434 no host
DATABASE_URL=postgresql://catalogo:catalogo@localhost:5434/catalogo

# Redis (docker-compose.yml) — porta 6380 no host
REDIS_URL=redis://localhost:6380

# API
PORT=3000
# Estratégia de cache: none | memory | redis | http
CACHE_STRATEGY=none
# Tempo de vida das entradas de cache (segundos)
CACHE_TTL_SECONDS=60
# Máximo de entradas do cache em memória (LRU)
MEMORY_CACHE_MAX_ENTRIES=10000
